# Plantilla: copiar solo estas variables al .env del entorno de pruebas.
# No se carga automaticamente. Completar credenciales localmente; no versionarlas.
MAIL_HOST=email-smtp.sa-east-1.amazonaws.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-responder@miajbpruebas.com.ar
MAIL_FROM_NAME=Mi AJB - Pruebas
MAIL_REPLY_TO=
MAIL_HELO_NAME=miajbpruebas.com.ar
# Activar solo despues de verificar DNS, SES y la entrega de un correo de prueba.
MAIL_ENABLED=false
# Bloquea el envio si falta una direccion de redireccion valida.
MAIL_TEST_MODE=true
MAIL_REDIRECT_TO=
# Mantener la URL operativa actual hasta configurar web y HTTPS del dominio nuevo.
MAIL_APP_URL=https://d2bnjhvusxwgza.cloudfront.net
MAIL_MAX_POR_MINUTO=30
MAIL_MAX_CONEXIONES=1
MAIL_TLS_ESTRICTO=true
MAIL_DEBUG=false
