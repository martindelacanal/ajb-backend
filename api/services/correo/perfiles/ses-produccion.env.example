# Plantilla futura: no aplicar mientras miajb.org.ar siga en el sistema anterior.
# No se carga automaticamente. Usar credenciales autorizadas para la identidad final.
MAIL_HOST=email-smtp.sa-east-1.amazonaws.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-responder@miajb.org.ar
MAIL_FROM_NAME=Mi AJB
MAIL_REPLY_TO=
MAIL_HELO_NAME=miajb.org.ar
# Activar solo en el cambio final, con SES verificado y acceso a produccion aprobado.
MAIL_ENABLED=false
MAIL_TEST_MODE=false
MAIL_REDIRECT_TO=
MAIL_APP_URL=https://miajb.org.ar
# Subir el ritmo solo segun las cuotas realmente concedidas por SES.
MAIL_MAX_POR_MINUTO=30
MAIL_MAX_CONEXIONES=1
MAIL_TLS_ESTRICTO=true
MAIL_DEBUG=false
